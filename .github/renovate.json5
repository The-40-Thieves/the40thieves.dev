{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // githubActionsVersions bumps `*_VERSION` workflow env vars that carry a `# renovate:` marker.
  extends: ['config:recommended', 'customManagers:githubActionsVersions'],
  // Match pnpm's minimumReleaseAge (10080 minutes): never propose a release younger than a week.
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  rangeStrategy: 'pin',
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on monday'],
  },
  vulnerabilityAlerts: {
    minimumReleaseAge: '0',
    labels: ['security'],
  },
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'non-major',
    },
    {
      matchManagers: ['github-actions'],
      pinDigests: true,
    },
  ],
}
