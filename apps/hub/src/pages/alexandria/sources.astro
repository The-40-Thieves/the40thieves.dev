---
import { SOURCE_ROUTES } from '@the40thieves/schemas';

import Base from '../../layouts/Base.astro';
import { sourcesLd } from '../../lib/json-ld.ts';
import {
  byCluster,
  keyText,
  ROUTE_NOTES,
  routeSummary,
  sourcesFile,
  upstreamTreeUrl,
} from '../../lib/sources.ts';

const file = sourcesFile;
const jsonLd = sourcesLd(file, __BUILD_INFO__);
const groups = byCluster(file);
const shortCommit = file.upstream.commit.slice(0, 7);
---

<Base
  title="alexandria sources"
  description="Which of alexandria-mcp's sources a browser may call directly, which go through the relay, and which stay MCP-only."
  jsonLd={jsonLd}
>
  <h1 class="text-4xl font-semibold tracking-tight">alexandria sources</h1>
  <p class="mt-4 text-lg text-ink/80">
    Which of alexandria-mcp's sources a browser on this site may call directly, which go through the
    relay, and which stay MCP-only. Probed from <code>{file.origin}</code> against
    <a class="underline underline-offset-2" href={upstreamTreeUrl(file)}>
      {file.upstream.repo}
    </a>
    at <code>{shortCommit}</code>; a weekly job re-runs the probe and proposes any change as a pull
    request.
  </p>
  <p class="mt-2 text-sm">
    <a class="underline underline-offset-2" href="/alexandria/sources.json">
      Data (JSON)
    </a>
    {' · '}
    <a class="underline underline-offset-2" href="/schemas/sources.json">
      JSON Schema
    </a>
    {' · '}
    <a class="underline underline-offset-2" href="/alexandria/sources.md">
      Markdown
    </a>
  </p>

  <p class="mt-8 font-medium">{routeSummary(file)}</p>
  <dl class="mt-4 space-y-2 text-sm text-ink/80">
    {SOURCE_ROUTES.map((route) => (
      <div>
        <dt class="inline font-mono font-medium text-ink">{route}</dt>
        <dd class="inline">: {ROUTE_NOTES[route]}.</dd>
      </div>
    ))}
  </dl>

  {groups.map((group) => (
    <section class="mt-10">
      <h2 id={group.cluster} class="text-xl font-semibold">
        <a class="hover:underline" href={`#${group.cluster}`}>
          {group.cluster}
        </a>
        <span class="ml-2 text-sm font-normal text-ink/60">{group.sources.length}</span>
      </h2>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-ink/70">
            <tr>
              <th class="py-1 pr-3 font-medium">Source</th>
              <th class="py-1 pr-3 font-medium">Kind</th>
              <th class="py-1 pr-3 font-medium">Key</th>
              <th class="py-1 pr-3 font-medium">CORS</th>
              <th class="py-1 pr-3 font-medium">Route</th>
              <th class="py-1 font-medium">Hosts</th>
            </tr>
          </thead>
          <tbody>
            {group.sources.map((source) => (
              <tr class="border-t border-ink/10 align-top">
                <td class="py-2 pr-3">
                  <a class="font-medium underline underline-offset-2" href={source.terms.url}>
                    {source.name}
                  </a>
                  <p class="mt-1 max-w-prose text-xs text-ink/70">{source.description}</p>
                </td>
                <td class="py-2 pr-3 font-mono">{source.kind}</td>
                <td class="py-2 pr-3 font-mono">{keyText(source)}</td>
                <td class="py-2 pr-3 font-mono">{source.cors}</td>
                <td class="py-2 pr-3 font-mono">{source.route}</td>
                <td class="py-2 font-mono">
                  {source.hosts.length > 0 ? source.hosts.join(' ') : 'none'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <p class="mt-10 text-sm">
    <a class="underline underline-offset-2" href="/">
      Home
    </a>
  </p>
</Base>
