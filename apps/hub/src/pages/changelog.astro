---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import { changelogLd } from '../lib/json-ld.ts';
import { renderPortableText } from '../lib/portable-text.ts';

const posts = (await getCollection('changelog'))
  .map((entry) => entry.data)
  .sort((a, b) => b.published_at.localeCompare(a.published_at));
const jsonLd = changelogLd(posts, __BUILD_INFO__);
const listed = new Set(
  (await getCollection('projects'))
    .filter((entry) => entry.data.listed)
    .map((entry) => entry.data.slug),
);
const day = (iso: string) => iso.slice(0, 10);
---

<Base
  title="Changelog"
  description="What changed on the40thieves.dev and in its tools."
  jsonLd={jsonLd}
>
  <h1 class="text-4xl font-semibold tracking-tight">Changelog</h1>
  <p class="mt-4 text-lg text-ink/80">
    What changed on this site and in the tools, written by hand. Release notes stay in the feed.
  </p>
  <p class="mt-2 text-sm">
    <a class="underline underline-offset-2" href="/releases.xml">
      Releases feed
    </a>
  </p>

  {posts.length === 0 ? (
    <p class="mt-10 text-ink/70">Nothing here yet.</p>
  ) : (
    <ol class="mt-10 space-y-10">
      {posts.map((post) => (
        <li id={post.slug}>
          <h2 class="text-xl font-semibold">
            <a class="hover:underline" href={`#${post.slug}`}>
              {post.title}
            </a>
          </h2>
          <p class="mt-1 text-sm text-ink/70">
            <time datetime={post.published_at}>{day(post.published_at)}</time>
            {post.project && listed.has(post.project) && (
              <>
                {' '}
                <a class="underline underline-offset-2" href={`/${post.project}/`}>
                  {post.project}
                </a>
              </>
            )}
          </p>
          <p class="mt-2 text-ink/80">{post.summary}</p>
          {post.body && <div class="release-notes mt-3" set:html={renderPortableText(post.body)} />}
        </li>
      ))}
    </ol>
  )}

  <p class="mt-10 text-sm">
    <a class="underline underline-offset-2" href="/">
      Home
    </a>
  </p>
</Base>
