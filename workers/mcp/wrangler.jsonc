{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-26",
  // nodejs_compat: the MCP SDK's JSON Schema validator. global_fetch_strictly_public: the Worker
  // makes no outbound call at all; the flag is belt and braces.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": false,
  "workers_dev": false,
  "preview_urls": false,
  // Only /mcp, /mcp/healthz and /mcp/server-card answer; the rest of /mcp* is a 404 from this Worker, so the hub's
  // prerendered /mcp/docs-index.json is never served live (the deploy reads it from dist).
  "routes": [{ "pattern": "the40thieves.dev/mcp*", "zone_name": "the40thieves.dev" }],
  // manifest.json and docs-index.json, uploaded by the deploy after every hub build.
  "kv_namespaces": [{ "binding": "MCP_KV", "id": "2778b9e491db4ee39ab3e2f95ef6ada7" }],
  // 100 requests per client IP per minute (P3-S1); src/ratelimit.ts mirrors the numbers.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  ],
  // Public configuration, not secrets. This Worker has no secrets.
  "vars": {
    "SITE": "https://the40thieves.dev",
  },
}
