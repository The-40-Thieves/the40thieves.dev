{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "site": {
      "type": "string",
      "format": "uri"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tagline": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "listed": {
            "type": "boolean"
          },
          "repo": {
            "type": "string",
            "format": "uri"
          },
          "page": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\/[a-z0-9-]+\\/$"
              },
              {
                "type": "null"
              }
            ]
          },
          "release": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "published_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "notes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes_truncated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "tag",
                  "published_at",
                  "url",
                  "notes",
                  "notes_truncated"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "install": {
            "type": "object",
            "properties": {
              "shell": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "claude-code": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "vscode": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "shell",
              "claude-code",
              "cursor",
              "vscode"
            ],
            "additionalProperties": false
          },
          "docs": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[^/\\s]+\\/[^/\\s]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "repo",
              "path",
              "sha"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "slug",
          "name",
          "tagline",
          "description",
          "listed",
          "repo",
          "page",
          "release",
          "install",
          "docs",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/(?:[a-z0-9-]+\\/)*$"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "read_only": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "input_schema": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[^/\\s]+\\/[^/\\s]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "repo",
              "path",
              "sha"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "description",
          "project",
          "read_only",
          "input_schema",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "project",
          "published_at",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "read_only": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "name",
              "description",
              "read_only"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "endpoint",
        "tools"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "generated_at",
    "commit",
    "site",
    "projects",
    "pages",
    "tools",
    "changelog",
    "mcp"
  ],
  "additionalProperties": false
}
